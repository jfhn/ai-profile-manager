{
  "name": "ai-profile-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:cli": "sh scripts/install-cli.sh",
    "uninstall:cli": "sh scripts/install-cli.sh --uninstall",
    "smoke": "sh scripts/smoke-cli.sh",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @apm/daemon --filter @apm/web dev",
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-svelte": "^3.0.2",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.3.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}

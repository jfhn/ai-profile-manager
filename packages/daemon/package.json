{
  "name": "@apm/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "apm": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts start --no-open --foreground",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apm/collectors": "workspace:*",
    "@apm/shared": "workspace:*",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
